# Memory-profile scenarios. Copy to scenarios.env (git-ignored) and fill in the chart names.
#   cp scenarios.example.env scenarios.env
# Sourced by run_scenarios.sh (bash): KEY=value, no spaces around "=", quote lists.

# compose: each profiled process is its own `docker compose run --rm <SERVICE>` container,
#          like separate worker pods (run on the VM host). Container memory is read from the host.
# local:   plain python processes in this shell (inside a container / AKS pod, or a venv).
MODE=compose

# compose mode: the core-pipeline folder (docker-compose.yml + .env) and the service whose
# image, env and mounts the runs use.
COMPOSE_DIR=../../core-pipeline
SERVICE=worker

# local mode: the interpreter (the core-pipeline venv or the image's python).
PYTHON=python

# Where the charts are, exactly as the API's input_type / container_name / input_path.
INPUT_TYPE=blob
CONTAINER=imaging-pipeline
INPUT_PATH=Raw_Input/Run1/Batch1/DEID_PNGs
# Empty: the chart is not written out to Blob afterwards (no write_out row). Set it, e.g.
# Processed/Run1, to measure the write-out too; it overwrites that chart's Processed folder.
OUTPUT_PATH=

# Charts by size (page count). Fill in real chart folder names.
CHART_SMALL=CHART_SMALL
CHART_MEDIUM=CHART_MEDIUM
CHART_LARGE=CHART_LARGE

# parallel-N: distinct charts, one process each (the same chart twice at once would share
# its working folder). PARALLEL_N caps how many of them run.
PARALLEL_CHARTS="CHART_A CHART_B CHART_C"
PARALLEL_N=3

# true: reuse OCR (no Azure Document Intelligence bill when the chart already has OCR).
# The skip-ocr scenario runs one full-OCR pass regardless (see NO_DOCINTEL).
SKIP_OCR=true
# true: stage 5 sends nothing to Document Intelligence in these runs (not billed; stage 5 is an
# HTTP call, so its own RAM is small; the chart's stored results lack Final OCR 2).
NO_DOCINTEL=false

# Sampling: per-process interval (s) inside stage_memory.py, and the host / container sampler (s).
INTERVAL=0.05
HOST_INTERVAL=1

# Passed to every stage_memory.py, e.g. "--gc-between --quiet" or "--env OMP_NUM_THREADS=2".
EXTRA_ARGS="--gc-between"

# compose mode: extra `docker compose run` options for every profiled container, e.g.
# "-e STAGE_WORKERS=2 -e MALLOC_ARENA_MAX=2" (variables the process must have from its start).
COMPOSE_RUN_ARGS=
