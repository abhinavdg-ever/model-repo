{
 "version": 1,
 "note": "The specialty stream. Parallel to page type, never nested inside it: a page is Progress Note / Office Visit Note AND Ophthalmology, not Progress Note > Ophthalmology. Optional by design. Measured on 623 real pages, a specialty is detectable on 43% and two or more compete on 12%, so 'Unspecified' is a normal answer rather than a failure. Strongest evidence is the practice name in the letterhead, which is why header hits are weighted above body hits.",
 "matching": {
  "header_band_fraction": 0.18,
  "header_weight": 6.0,
  "body_weight": 1.0,
  "min_score": 6.0,
  "margin_to_decide": 3.0,
  "comment_margin": "If the top two specialties are within this, the page is Ambiguous rather than a coin flip. Resolve it at document level instead.",
  "inherit_across_document": true,
  "comment_inherit": "A specialty found on any page of a document applies to every page of it. A lab table on page 4 of an ophthalmology note is still ophthalmology."
 },
