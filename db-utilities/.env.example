# db-utilities settings. Copy to .env and fill in the blanks. Keep both files in the same order.

# --- 1. DATABASE (the same database as core-pipeline and review-ui) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/imaging_outputs

# --- 2. AZURE BLOB (only for --blob-prefix; auth: managed_identity | entra; a key or connection string wins) ---
AZURE_STORAGE_AUTH=managed_identity
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
AZURE_CLIENT_ID=

# --- 3. DOCKER (host folder mounted read-only at /input) ---
INPUT_HOST_PATH=./input
