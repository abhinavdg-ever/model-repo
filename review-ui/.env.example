# The database is review-ui's only source of results (no Local mode since 2026-11-07);
# page images come from Azure Blob (the block below).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs
DB_SCHEMA=public
# Pooled connections, as in core-pipeline (DB_POOL_MIN / DB_POOL_MAX): kept
# open / at most. Keep both services' maxima together under Postgres
# max_connections (100 by default; core-pipeline uses up to 20). A chart open runs up
# to 4 queries at once: 4 kept open means it never waits for a new connection.
DB_POOL_MIN=4
DB_POOL_MAX=20
# Seconds a request waits for a free connection before failing.
DB_POOL_WAIT_SEC=10

# --- Azure Blob: page images (chart_list.blob_container + blob_path) ---
# The same names and values as core-pipeline/.env: copy that block across.
# Auth, as core-pipeline: managed_identity (the VM: AZURE_CLIENT_ID = the user-assigned
# identity, blank = system-assigned) | entra (managed identity, then az login) |
# client_secret (an Entra app: AZURE_TENANT_ID + AZURE_CLIENT_ID + AZURE_CLIENT_SECRET,
# used only in this mode). A key or connection string, when set, is used instead.
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
# Default container (a chart's own blob_container in Postgres wins).
AZURE_STORAGE_CONTAINER=imaging-pipeline
# AZURE_CLIENT_ID: the managed identity's client id (managed_identity / entra), or the
# app's (client_secret). AZURE_CLIENT_SECRET is read only with
# AZURE_STORAGE_AUTH=client_secret: its Value, never its Secret ID (a GUID).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Older names, still read: BLOB_ACCOUNT_URL (instead of AZURE_STORAGE_ACCOUNT_NAME),
# BLOB_CONTAINER, BLOB_AUTH_MODE. BLOB_AUTH_MODE=sas + BLOB_SAS_TOKEN = legacy SAS redirect.

# CORS for the Vite/dev and Docker frontend origins
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4001,http://localhost:4001

# Sign-in (users table; utilities/create_user.py adds users). AUTH_SECRET signs the
# session token: set a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Empty = a new secret each start (everyone signs in again after a restart).
AUTH_SECRET=
# One local admin account that needs no users row (works with or without a database).
# Both empty = no such account. Keep these out of git; never reuse a real password.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Accuracy report: semantic page-type match (MiniLM, ONNX). Empty = ../core-pipeline/models/semantic-model
# locally, /models/semantic-model in Docker (SEMANTIC_MODEL_HOST_PATH mounts it). Absent = no semantic match.
SEMANTIC_MODEL_PATH=
# Docker only: host folder mounted at /models/semantic-model.
# SEMANTIC_MODEL_HOST_PATH=../core-pipeline/models/semantic-model

# Playground (admins only, profile menu): start a core-pipeline batch run over a blob
# folder; output goes to the matching Processed folder. The pipelines a run can go to,
# comma-separated "Label=URL" pairs, first = default; empty = off. In Docker use
# host.docker.internal for the pipeline on the same host.
CORE_PIPELINE_URLS=VM=http://172.20.4.170:8001,Local=http://localhost:8001
PLAYGROUND_CONTAINER=imaging-pipeline

# The client's copy only (review-ui-client): Page Details shows Final alone, headed
# Algorithm. Leave false here.
CLIENT_VIEW=false

# --- Platform (docs/PLATFORM_PLAN.md phase 6) — NOT READ YET. review-ui reads Cosmos
# (read-only key is enough) and page images from Blob; no local mode then. ---
# Short-term toggle: postgres (default, today) | cosmos. Not read yet.
DB_BACKEND=postgres
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=imaging
