# UI data source mode:
#   local       → Local Mode — OCR + imaging from data/folders (CSVs / txt / json)
#   production  → Production Mode — OCR + imaging from Postgres (page images still local)
#   postgres    → accepted alias for production
DATA_MODE=local

# Local filesystem root containing document folders (written by core-pipeline)
DATA_ROOT=./data/folders

# Pipeline CSV drop folder — used in Local Mode only
PIPELINE_ROOT=./data/pipeline

# Manifest Details CSVs — Local Mode; Production Mode uses manifest_member_list
METADATA_ROOT=./data/metadata

# Postgres (required for Production Mode). Apply ../schema/schema.sql first.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/imaging_outputs
DB_SCHEMA=public

API_HOST=127.0.0.1
API_PORT=8002
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3001,http://localhost:3001

FILE_VIEWER_BLOB_ENABLED=false
BLOB_AUTH_MODE=entra
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=imaging-pipeline
BLOB_PATH_TEMPLATE=Raw_Input/Run1/Batch1/DEID_PNGs/

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Frontend demo gate (build-time, inlined into the JS bundle — NOT auth).
# Defaults to demo/demo when unset.
VITE_LOGIN_USERNAME=demo
VITE_LOGIN_PASSWORD=demo
