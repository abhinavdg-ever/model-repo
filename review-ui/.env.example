# local = disk CSVs/JSON | production (or postgres) = OCR/imaging from Postgres
DATA_MODE=local
# Chart workspace (optional in production — images come from blob_path)
DATA_ROOT=./data/folders
# Local-mode only: metadata_R*_B*.csv for Manifest Details
METADATA_ROOT=./data/metadata

# Local-mode: also used for Run/Batch and Manifest Details from Postgres
# (metadata CSV is fallback when a chart has no row).
# Required when DATA_MODE=production (plain postgresql:// or postgresql+psycopg://)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs
DB_SCHEMA=public

# Production Mode page images: Azure Blob via chart_list.blob_container + blob_path
# (same account the pipeline uses). BLOB_ACCOUNT_URL or AZURE_STORAGE_ACCOUNT_NAME.
BLOB_ACCOUNT_URL=
# Default container name (per-chart blob_container in Postgres wins when set)
BLOB_CONTAINER=imaging-pipeline
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional File Viewer toggle (separate /api/blob/… template path)
FILE_VIEWER_BLOB_ENABLED=false
BLOB_AUTH_MODE=entra
BLOB_PATH_TEMPLATE={folder}/pages/{filename}

API_HOST=127.0.0.1
API_PORT=8002
# CORS for the Vite/dev and Docker frontend origins
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4001,http://localhost:4001

# Frontend demo gate (build-time; not real auth)
VITE_LOGIN_USERNAME=imaging-user
VITE_LOGIN_PASSWORD=aipocpw2026
