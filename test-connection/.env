# Managed-identity connectivity test — fill in the blanks and run.
# Read directly by test_blob_mi.py and test_openai_mi.py; no python-dotenv, no
# shell sourcing. A real environment variable always wins over a line here:
#
#     AZURE_STORAGE_ACCOUNT=otheracct python3 test_blob_mi.py
#
# There are NO secrets in this file and there must never be: no account keys,
# no connection strings, no SAS tokens, no client secrets. The only credential
# is the identity attached to the VM.
#
# Blank values are ignored, so an unset line behaves exactly like a missing one.


# --- the identity -----------------------------------------------------------
# az-mi-dv-e2-ai-poc, User-Assigned Managed Identity.
# The CLIENT ID — the value the code passes to Azure. Already filled in.
#   example: AZURE_CLIENT_ID=ad1f4c35-f64d-4cb8-a7bc-3f97d5f9f767
AZURE_CLIENT_ID=ad1f4c35-f64d-4cb8-a7bc-3f97d5f9f767

# The PRINCIPAL / OBJECT ID. Used ONLY when assigning an RBAC role
# (az role assignment create --assignee-object-id ...). It is not a credential
# and neither script reads it — it lives here so both IDs are in one place.
#   example: AZURE_PRINCIPAL_ID=8847dea2-3dd2-464b-9ae1-f0505c274f4e
AZURE_PRINCIPAL_ID=8847dea2-3dd2-464b-9ae1-f0505c274f4e


# --- blob test (test_blob_mi.py) --------------------------------------------
# The storage account NAME only, not the URL and not the resource ID.
#   example: AZURE_STORAGE_ACCOUNT=advantmedimaging
#   wrong:   AZURE_STORAGE_ACCOUNT=https://advantmedimaging.blob.core.windows.net
# The script builds https://<name>.blob.core.windows.net itself.
AZURE_STORAGE_ACCOUNT=

# Optional. Left blank, the test lists the account's containers instead, which
# needs the role at account scope rather than container scope.
#   example: AZURE_STORAGE_CONTAINER=imaging-pipeline
AZURE_STORAGE_CONTAINER=


# --- Azure OpenAI test (test_openai_mi.py) ----------------------------------
# The resource root. The script appends /openai/v1 itself, so either form works.
#   example: AZURE_OPENAI_ENDPOINT=https://openai-algodel.openai.azure.com
#   example: AZURE_OPENAI_ENDPOINT=https://openai-algodel.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=

# The DEPLOYMENT name on that resource, which is whatever it was named at
# deployment time — NOT the model name, though the two often match.
#   example: AZURE_OPENAI_DEPLOYMENT=gpt-4o
#   example: AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=
