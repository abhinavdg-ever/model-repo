# .gitignore for the CLIENT's Azure DevOps repo (copied there as .gitignore by
# deploy/prepare_for_devops.ps1). GitHub keeps everything; DevOps and the VM get only
# what runs. See deploy/README.md.

# --- Development only: on GitHub, never on the VM ---
training/
scripts/
tests/
deploy/
.venv-test/
CLAUDE.md
PLAN.md

# --- Secrets: each host keeps its own .env (made from .env.example) ---
.env
**/.env
!**/.env.example

# --- Weights: the big ones are copied onto the VM by hand, never committed. The small
#     files GitHub keeps (joblib heads, heads.pt, the hw pkl) DO go through: the VM needs them.
*.safetensors
*.onnx
*.bin
*.pth
core-pipeline/models/blank-junk/bert/
core-pipeline/models/ner/
core-pipeline/models/rapidocr/
core-pipeline/models/docling/
core-pipeline/models/semantic-model/

# --- Written at run time ---
core-pipeline/logs/**
!core-pipeline/logs/README.md
core-pipeline/outputs/
core-pipeline/outputs/charts/*
!core-pipeline/outputs/charts/.gitkeep
core-pipeline/outputs/metadata/*
!core-pipeline/outputs/metadata/.gitkeep
utilities/output/
*.log

# --- Build and tool output ---
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
node_modules/
dist/
*.tmp

# --- OS clutter ---
.DS_Store
._*
Thumbs.db
desktop.ini

# --- db-utilities: the files to load are per host, never committed ---
db-utilities/input/*
!db-utilities/input/.gitkeep
