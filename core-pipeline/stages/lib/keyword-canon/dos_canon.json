  "clinical_cues": [
    "chief\\s+complaint",
    "history\\s+of\\s+present\\s+illness|\\bhpi\\b",
    "discharge\\s+(summary|note|diagnos|instruction)",
    "reason\\s+for\\s+(consult|visit|admission)",
