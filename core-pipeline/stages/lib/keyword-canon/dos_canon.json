{
  "note": "Date-of-service scorer. Every date on a page is a candidate; each gets score = base + label weight - distance decay + edge/cue/cluster bonuses - age penalty, clamped to [0,1]. The best candidate at or above DOS_MIN_SCORE is the page's date. Edit weights and label phrases here, not in dos_logic.py. Reloads on change.",
  "DOS_MAX_AGE_YEARS": 6,
  "DOS_MIN_SCORE": 0.55,
  "DOS_DEFAULT_DATE": "2022-02-02",
  "base": 0.5,
  "label_weights": {
    "encounter": 0.4,
    "admit": 0.3,
    "discharge": 0.3,
    "none": -0.1,
    "procedure": -0.3,
    "future": -0.4,
    "doc_meta": -0.45,
    "birth": -0.5
  },
  "label_distance_decay": 0.002,
  "edge_bonus": 0.1,
  "clinical_cue_bonus": 0.1,
  "cluster_bonus": 0.05,
  "cluster_cap": 3,
  "age_penalty": 0.35,
  "timestamp_penalty": 0.3,
  "note_timestamp": "A date with a clock time beside it (03/20/2024 10:15 AM, 2025-12-31T10:00) is usually a print, fax or signature stamp in the header or footer: it loses timestamp_penalty and gets no edge_bonus. A labelled encounter time (Arrival Date: 03/14/2024 14:32) still clears DOS_MIN_SCORE.",
  "span_override_score": 0.75,
  "llm_confidence": 0.7,
  "window_left_chars": 80,
  "window_right_chars": 40,
  "edge_words": 60,
  "cluster_days": 30,
  "range_pair_chars": 200,
  "labels": {
    "encounter": [
      "encounter date",
      "date of service",
      "date of visit",
      "service date",
      "ed visit date",
      "presentation date",
