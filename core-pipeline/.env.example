# Shared with review-ui; plain postgresql:// or postgresql+psycopg:// both work
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs
DB_POOL_MIN=1
DB_POOL_MAX=20

# Must be the same chart workspace review-ui mounts
DATA_ROOT=../review-ui/data/folders
METADATA_ROOT=../review-ui/data/metadata

API_HOST=0.0.0.0
API_PORT=8001
# Pages processed in parallel inside one chart's stage (e.g. OCR on 4 pages at once)
STAGE_WORKERS=4
# Docling final1: keep at 1 (Torch/RapidOCR thrashing); empty/timeout → onnx fallback
DOCLING_WORKERS=1
DOCLING_PAGE_TIMEOUT_SECONDS=90
# TableFormer: fast (default) | accurate. Cell matching off unless needed.
DOCLING_TABLE_MODE=fast
DOCLING_DO_TABLES=true
DOCLING_TABLE_CELL_MATCHING=false
# Full DoclingDocument JSON in final1 output (large/slow) — leave false
DOCLING_EXPORT_DOCUMENT=false
# Charts processed in parallel inside one /batch (or cli batch) call
BATCH_WORKERS=4
# DB connections reserved beyond workers×STAGE_WORKERS (must fit DB_POOL_MAX)
BATCH_POOL_HEADROOM=2
# Cap concurrent Azure DI calls (billed); keep ≤ service quota
AZURE_DI_MAX_CONCURRENT=4
AZURE_RETRY_ATTEMPTS=5
AZURE_RETRY_BASE_DELAY=1.0
AZURE_RETRY_MAX_DELAY=30.0

# Blob intake: key | entra | entra_interactive | managed_identity
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
# User-assigned MI on a VM (system-assigned: leave both blank)
# client_id → ManagedIdentityCredential; principal_id → RBAC / ops only
AZURE_CLIENT_ID=
AZURE_PRINCIPAL_ID=
# Parallel blob workers (SDK default ~10)
AZURE_BLOB_CONNECTION_POOL_SIZE=50

# Final OCR 2 (billed per page) — leave blank to skip Azure text
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_POLL_TIMEOUT_SECONDS=180
# Comma-separated DI features (empty / off = text only)
AZURE_DI_FEATURES=languages,barcodes
AZURE_DI_CONNECTION_POOL_SIZE=32

# ---------------------------------------------------------------------------
# Models (resolved at uvicorn startup — see the "models & capabilities" banner)
# Paths below are relative to core-pipeline/ unless absolute.
# ---------------------------------------------------------------------------
# Handwriting (stage 1): ConvNeXt preferred; RF .pkl used if .pth/torch missing
HW_MODEL_PATH=models/hw/handwritten_printed_convnext_tiny.pth
#   backup (auto): models/hw/image_type_classification.pkl
#
# Docling final1 RapidOCR Torch weights (download separately — see docs/API.md)
RAPID_MODELS_DIR=models/rapidocr
#   expected: PP-OCRv6_det_small.pth, PP-OCRv6_rec_small.pth,
#             ch_ptocr_mobile_v2.0_cls_mobile.pth, ppocrv6_dict.txt
#
# GLiNER member NER (rejection needs ENABLED=true + downloaded checkpoints)
WITH_NER=false
MEMBER_NER_ENABLED=false
MEMBER_NER_MODEL_ID=gliner_medium
MEMBER_NER_MODELS_PATH=
#   default when blank: models/ner/  (via model_downloader)

# DOS LLM pass — blank endpoint ⇒ rules-only
DOS_LLM_ENABLED=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# key | entra | auto
AZURE_OPENAI_AUTH=auto
AZURE_OPENAI_API_KEY=

# Write corrected-pages/ when orientation changes
ROTATION_CORRECTION_ENABLED=true
# Reuse existing ocr/ files (skip prelim/final1/final2). If ocr/ missing → OCR still runs.
# Per-request override: API body "skip_ocr": true | CLI --skip-ocr (even when this is false)
SKIP_OCR=false
# Quiet Azure SDK HTTP dumps (WARNING recommended)
AZURE_LOG_LEVEL=WARNING
# Windows only if tesseract is not on PATH
TESSERACT_CMD=
