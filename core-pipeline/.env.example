# core-pipeline settings — copy to .env and fill in.
#
# Grouped by what they configure, most important first. A commented-out line shows the
# default: uncomment it only to change it. Paths are relative to core-pipeline/.
#
#   1. Database              6. Models               11. Files, logs, retention
#   2. Azure Blob            7. Member NER           12. Debug and diagnostics
#   3. Doc Intelligence      8. Stage settings       13. API and Docker
#   4. Azure (shared)        9. Throughput           14. Platform (not read yet)
#   5. Monitoring / prices  10. Tesseract
#
# Ubuntu VM:  cp .env.example .env && nano .env
# Windows:    Copy-Item .env.example .env; notepad .env

# =============================================================================
# 1. DATABASE
# =============================================================================
# Postgres, shared with review-ui. New database: psql -f ../schema/schema.sql.
# Existing database, after every release: psql -f ../schema/migrate.sql.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs
# Connection pool. Keep BATCH_WORKERS x STAGE_WORKERS + BATCH_POOL_HEADROOM <= DB_POOL_MAX
# (section 9), or batch-run returns 400.
DB_POOL_MIN=1
DB_POOL_MAX=20

# =============================================================================
# 2. AZURE BLOB — chart intake (input_type "blob") and page images
# =============================================================================
# Local input paths need none of this.
# Auth: key | entra | entra_interactive | managed_identity (the VM)
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
# Managed identity: the user-assigned identity's client id (blank = system-assigned) and
# its object id (shown in /health, for RBAC role assignments).
AZURE_CLIENT_ID=
AZURE_PRINCIPAL_ID=
AZURE_BLOB_CONNECTION_POOL_SIZE=50

# =============================================================================
# 3. AZURE DOCUMENT INTELLIGENCE — Final OCR 2. BILLED PER PAGE.
# =============================================================================
# Blank: no Final OCR 2 text, and handwritten pages get no pass-2 verdict.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DI_FEATURES=languages,barcodes
AZURE_POLL_TIMEOUT_SECONDS=180
# Calls in flight at once, and the HTTP pool behind them.
AZURE_DI_MAX_CONCURRENT=4
AZURE_DI_CONNECTION_POOL_SIZE=32

# =============================================================================
# 4. AZURE (shared by Blob and Doc Intelligence)
# =============================================================================
AZURE_RETRY_ATTEMPTS=5
AZURE_RETRY_BASE_DELAY=1.0
AZURE_RETRY_MAX_DELAY=30.0
# INFO / DEBUG brings back the Azure SDK's HTTP dumps (for a 403 or throttling).
AZURE_LOG_LEVEL=WARNING

# =============================================================================
# 5. MONITORING — prices for run_usage (python cli.py usage)
# =============================================================================
# Each run records its time, Doc Intel pages and LLM tokens with the cost at these prices;
# the price is stored with the row, so changing it later never rewrites history.
PRICE_CURRENCY=USD
# Azure list price for prebuilt-read, per 1,000 pages. Use your contract price.
PRICE_DOCINTEL_PER_1000_PAGES=1.50
# LLM (when one is used): per 1,000 tokens, one pair per deployment name, upper-cased with
# non-letters as _, e.g. deployment gpt-4o-mini:
# PRICE_LLM_GPT_4O_MINI_IN_PER_1000=0.00015
# PRICE_LLM_GPT_4O_MINI_OUT_PER_1000=0.0006

# =============================================================================
# 6. MODELS — weights live in core-pipeline/models/, never in the image or git
# =============================================================================
# Defaults match the folder layout; change a path only if you moved a folder.
# Docs: docs/HOW_TO_RUN.md § Models.

# Stage 1 handwriting / page type. The page-tag model goes in under this name.
HW_MODEL_PATH=models/hw/handwritten_printed_convnext_tiny.pth
# Final OCR 1: four RapidOCR files, plus Docling layout / table weights (Docling downloads
# its own on the first Final OCR 1 page when online).
RAPID_MODELS_DIR=models/rapidocr
DOCLING_ARTIFACTS_DIR=models/docling
# Section headers: local MiniLM, else this Hub id, else a lexical match.
SECTION_HEADER_MINILM_PATH=models/semantic-model
# SECTION_HEADER_MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Blank / junk: <dir>/bert/ = DistilBERT, the primary model (config.json,
# model.safetensors, tokenizer.json, tokenizer_config.json, bjnk_meta.json; needs torch +
# transformers). Without it the vote runs on keywords alone. /health -> blank_junk_model.
BLANK_JUNK_MODEL_DIR=models/blank-junk
# Page-leaf model (training/bert-training-leaf/train_leaf.py): one class per whole
# L1 > L2 > L3 path, with keyword-canon/leaf_keywords.json. Encoder not in git (copy it).
# Missing: the page-axes model stands in (/health -> page_leaf).
PAGE_LEAF_MODEL_DIR=models/page-family/page-leaf
# Page-axes model: the backup classifier, used only when the page-leaf model is missing.
# encoder/ (Bio_ClinicalBERT, 433 MB, not in git: copy it), heads.pt, label_space.json on
# taxonomy v29.3. Guide: docs/APPROACH.md §7.4.
PAGE_AXES_MODEL_DIR=models/page-family/page-axes
# leaf (default: page-leaf model + leaf keywords) or axes (the L1 / L2 / L3 cascade).
PAGE_CLASSIFIER=leaf
# Encounter model (training/bert-training-encounter): one vote per page. Encoder not in
# git (copy it). Missing: the rules decide alone.
ENCOUNTER_MODEL_DIR=models/encounter
# Key/value extraction: kv-extraction/ and layout_heron/ under this root. Its GLiNER is
# the member NER checkpoint (section 7).
EXTRACTION_MODELS_ROOT=models
# EXTRACTION_DATA_ROOT=data/extraction
# 1 on a machine without internet: a missing model is reported, never fetched.
# HF_HUB_OFFLINE=1

# =============================================================================
# 7. MEMBER NER (GLiNER) — rejection is only possible with it on
# =============================================================================
# Needs models/ner/<checkpoint>; fetch with
#   python -m stages.lib.member.extractors.ner_based.model_downloader
# Missing checkpoints: the member stage runs rules-only and /health says so.
MEMBER_NER_ENABLED=true
MEMBER_NER_MODEL_ID=gliner_medium
MEMBER_NER_MODELS_PATH=models/ner

# =============================================================================
# 8. STAGE SETTINGS
# =============================================================================
# --- Stage 1: rotation, tilt, mirror ---
ROTATION_CORRECTION_ENABLED=true
# A measured tilt above this many degrees is stored but not applied.
MAX_TILT_TO_APPLY=5

# --- Final OCR 1 (Docling + RapidOCR) ---
# On timeout or sparse output a page falls back to RapidOCR-onnx.
DOCLING_PAGE_TIMEOUT_SECONDS=90
DOCLING_TABLE_CELL_MATCHING=false
# DOCLING_TABLE_MODE=fast            # fast | accurate (accurate is ~10x slower)
# DOCLING_DO_TABLES=true
# DOCLING_IMAGES_SCALE=1.0
# DOCLING_EXPORT_DOCUMENT=false      # true adds the full Docling document to the JSON
# Leave unset: CUDA when present, else CPU. A Mac's MPS crashes the layout model.
# DOCLING_DEVICE=cpu

# --- Section headers ---
SECTION_HEADER_SEMANTIC_ENABLED=true
SECTION_HEADER_SEMANTIC_THRESHOLD=0.90

# --- Page sequencing: optional cross-encoder ---
# Needs stages/lib/sequencing/artifacts/cross_encoder_mini_lm.onnx.
SEQUENCING_CROSS_ENCODER=false

# --- OCR reuse ---
# true: reuse OCR from the chart folder, else rebuild it from ocr_results; OCR runs only
# when neither exists. Same as skip_ocr per request (no Doc Intel bill).
SKIP_OCR=false

# =============================================================================
# 9. THROUGHPUT
# =============================================================================
# Pages processed at once inside a chart, and charts at once inside a batch.
# Ubuntu VM (16 CPU / 64 GB): STAGE_WORKERS=4, BATCH_WORKERS=4 is a safe start.
STAGE_WORKERS=4
BATCH_WORKERS=4
BATCH_POOL_HEADROOM=2
# Docling is not safe under fan-out; Final OCR 1 pages queue on one convert.
DOCLING_WORKERS=1
# Charts above this many pages run one at a time inside a batch.
# LARGE_CHART_MIN_PAGES=500
# One OpenMP thread stops Torch and ONNX pools fighting each other.
OMP_NUM_THREADS=1

# =============================================================================
# 10. TESSERACT (stage 1 and preliminary OCR)
# =============================================================================
# Leave blank when `tesseract` is on PATH (macOS / Ubuntu).
# Windows always: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Seconds before one Tesseract call (OSD / readability) is abandoned.
# ROTATION_TESSERACT_TIMEOUT=30

# =============================================================================
# 11. FILES, LOGS AND RETENTION
# =============================================================================
# Scratch space: leave unset. Chart working folders go to outputs/charts (deleted after
# OUTPUTS_RETENTION_DAYS without a run), manifests to outputs/metadata. review-ui never
# reads these; it reads the database and Azure Blob.
# DATA_ROOT=outputs/charts
# METADATA_ROOT=outputs/metadata
# OUTPUTS_RETENTION_DAYS=7
# Daily log files under LOG_DIR (default ./logs), also on stdout; deleted after
# LOG_BACKUP_DAYS, checked on the first run of each day.
LOG_TO_FILE=true
# LOG_DIR=
LOG_BACKUP_DAYS=7
# Colour the [batch-N] / [page-N] tags: auto | true | false. NO_COLOR=1 also turns it off.
LOG_COLOR=auto

# =============================================================================
# 12. DEBUG AND DIAGNOSTICS
# =============================================================================
# Per-chart evidence files under <chart>/debug/ (never exported).
DOS_DEBUG=false
PAGE_CLASSIFY_DEBUG=false
ENCOUNTER_DEBUG=false
KV_DEBUG=false
# Native crash diagnostics: a traceback on abort. If Docling crashes with heap
# corruption, try BATCH_WORKERS=1 first.
PYTHONFAULTHANDLER=1

# =============================================================================
# 13. API AND DOCKER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8001
# Host folders docker compose mounts (read by compose, not by Python).
# OUTPUTS_HOST_PATH=./outputs
# MODELS_HOST_PATH=./models
# LOGS_HOST_PATH=./logs

# =============================================================================
# 14. PLATFORM (docs/PLATFORM_PLAN.md) — NOT READ YET; fill in for phase 0
# =============================================================================
# Short-term switch: postgres (today) | cosmos.
DB_BACKEND=postgres
# Cosmos DB (NoSQL API, provisioned throughput)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=imaging
# Service Bus (queue chart-runs, sessions on; Standard tier or higher)
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE=chart-runs
# Orchestrator API key: callers send it as the X-API-Key header.
ORCHESTRATOR_API_KEY=
