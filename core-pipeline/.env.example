# core-pipeline — copy to .env and fill in.
# Only variables the code reads. Paths are relative to core-pipeline/ unless absolute.

# --- Database (shared with review-ui) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs
DB_POOL_MIN=1
DB_POOL_MAX=20

# --- Workspace (same paths review-ui mounts) ---
DATA_ROOT=../review-ui/data/folders
METADATA_ROOT=../review-ui/data/metadata

# --- API ---
API_HOST=0.0.0.0
API_PORT=8001

# --- Workers (BATCH_WORKERS × STAGE_WORKERS + BATCH_POOL_HEADROOM ≤ DB_POOL_MAX) ---
STAGE_WORKERS=4
BATCH_WORKERS=4
BATCH_POOL_HEADROOM=2

# --- Stage 1: handwriting + rotation ---
HW_MODEL_PATH=models/hw/handwritten_printed_convnext_tiny.pth
ROTATION_CORRECTION_ENABLED=true
TESSERACT_CMD=

# --- Stage 4 final1 (Docling / RapidOCR) ---
RAPID_MODELS_DIR=models/rapidocr
DOCLING_WORKERS=1
DOCLING_PAGE_TIMEOUT_SECONDS=90
DOCLING_TABLE_MODE=fast
DOCLING_DO_TABLES=true
# OFF by default (speed). true fills dense form table cells but often hits the
# 90s page timeout; RapidOCR-onnx then takes over as final1 backup.
DOCLING_TABLE_CELL_MATCHING=false
# Keep 1.0 for page images — 2.0 (PDF default) doubles page.size vs bbox pixels.
# DOCLING_IMAGES_SCALE=1.0
DOCLING_EXPORT_DOCUMENT=false
# Final1 section_headers: keep only phrases ≥90% similar to known clinical
# headers (MiniLM via sentence-transformers; lexical fallback without it).
SECTION_HEADER_SEMANTIC_ENABLED=true
SECTION_HEADER_SEMANTIC_THRESHOLD=0.90
# Local MiniLM (preferred). Download once:
#   python -m stages.lib.imaging.section_header_match --download
SECTION_HEADER_MINILM_PATH=models/semantic-model
# Hub id used only when the local folder is missing:
# SECTION_HEADER_MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Azure Blob (intake + manifest sweep) ---
# Auth: key | entra | entra_interactive | managed_identity
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
AZURE_CLIENT_ID=
AZURE_PRINCIPAL_ID=
AZURE_BLOB_CONNECTION_POOL_SIZE=50
AZURE_RETRY_ATTEMPTS=5
AZURE_RETRY_BASE_DELAY=1.0
AZURE_RETRY_MAX_DELAY=30.0

# --- Stage 5 final2 (Azure Document Intelligence — billed) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_POLL_TIMEOUT_SECONDS=180
AZURE_DI_FEATURES=languages,barcodes
AZURE_DI_CONNECTION_POOL_SIZE=32
AZURE_DI_MAX_CONCURRENT=4

# --- Stage 8 DOS LLM (blank endpoint ⇒ rules-only) ---
DOS_LLM_ENABLED=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_AUTH=auto
AZURE_OPENAI_API_KEY=

# --- Member NER (rejection needs ENABLED=true + checkpoints on disk) ---
# Docker: Docling packages are always in the image. GLiNER runtime still needs
# WITH_NER=true at build. Weights (hw/rapidocr/semantic-model/ner) are mounted
# from MODELS_HOST_PATH (default ./models) — scp them onto the host separately.
WITH_NER=false
MEMBER_NER_ENABLED=false
MEMBER_NER_MODEL_ID=gliner_medium
MEMBER_NER_MODELS_PATH=

# --- Behaviour ---
# When true: skip OCR engines if the *output folder* (or workspace) ocr/ has
# files, else write the three ocr/ files from ocr_results in the DB. If neither
# exists, OCR still runs. force=true on run/batch always re-OCRs.
SKIP_OCR=false
# Batch: ≥ this many pages = "large"; at most one large chart runs while any
# smaller chart is still pending. When only large charts remain, workers parallelize.
# LARGE_CHART_MIN_PAGES=100
# Quiet Azure HTTP dumps and Docling convert INFO (WARNING keeps real failures).
# Set INFO/DEBUG to bring the dumps back when diagnosing a 403 or throttle.
AZURE_LOG_LEVEL=WARNING
# Daily file logs under LOG_DIR (default ./logs). Still mirrored to stdout.
LOG_TO_FILE=true
# LOG_DIR=
LOG_BACKUP_DAYS=30
# Colour [batch-N] / [page-N] tags in the terminal (auto|true|false).
LOG_COLOR=auto
