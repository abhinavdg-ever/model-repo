# ---------------------------------------------------------------------------
# core-pipeline configuration
# Copy to .env and fill in. Deployed independently of review-ui; the two share
# only DATABASE_URL and the data/folders volume.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Both services accept plain postgresql:// and the SQLAlchemy form
# postgresql+psycopg://. Prefer plain, so one value works in both .env files.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs
DB_POOL_MIN=1
DB_POOL_MAX=8

# --- Chart workspace --------------------------------------------------------
# Must point at the same storage review-ui reads.
DATA_ROOT=../review-ui/data/folders
METADATA_ROOT=../review-ui/data/metadata

# --- Service ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8001
# Pages processed concurrently inside one stage. Keep <= DB_POOL_MAX.
STAGE_WORKERS=4

# --- Azure Blob (chart intake + manifest sweep) ------------------------------
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline

# --- Azure Document Intelligence (final2 OCR — billed per page) --------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_POLL_TIMEOUT_SECONDS=180

# --- Azure OpenAI (the DOS stage LLM pass) ----------------------------------
# Leave the endpoint blank to run DOS rules-only. The stage records
# extraction_method='rules' so a degraded run is visible in the data.
DOS_LLM_ENABLED=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# How to authenticate: key | entra | auto.
#   key    AZURE_OPENAI_API_KEY below is required.
#   entra  no key at all — the VM's managed identity, or an `az login`. The
#          identity needs the "Cognitive Services OpenAI User" role ON THE
#          RESOURCE; without it the call is a 401 that reads like a bad key.
#   auto   (default) key if one is set below, otherwise entra.
# Leaving all of this alone keeps the old key-only behaviour.
AZURE_OPENAI_AUTH=auto
AZURE_OPENAI_API_KEY=

# --- Member verification ----------------------------------------------------
# The NER layer is fully implemented but needs two things that are not vendored:
#   1. the runtime:      pip install -r requirements-ner.txt   (~2.5 GB)
#                        docker:  WITH_NER=true
#   2. the checkpoints:  python -m stages.lib.member.extractors.ner_based.model_downloader
#
# IMPORTANT: while MEMBER_NER_ENABLED is false the wrong-member check cannot
# fire, so no document can ever be Rejected. GET /health -> member_ner reports
# which precondition is unmet. See docs/LOGIC.md.
WITH_NER=false
MEMBER_NER_ENABLED=false
MEMBER_NER_MODEL_ID=gliner_medium
# Where the downloader writes the ~2 GB of GLiNER checkpoints.
# Default (blank): core-pipeline/models/ner — gitignored, and the same path the
# compose file mounts as NER_MODELS_HOST_PATH. Change both together or not at all.
MEMBER_NER_MODELS_PATH=
# (GLINER_LARGE / GLINER_MEDIUM / GLINER_LOW were removed — MEMBER_NER_MODEL_ID
#  is now the only model knob, and the downloader fetches just that one.)

# --- Local tooling ----------------------------------------------------------
TESSERACT_CMD=
# Ships with the repo; override only to point at a retrained classifier.
HW_MODEL_PATH=stages/lib/imaging/image_type_classification.pkl
