# Shared with review-ui; plain postgresql:// or postgresql+psycopg:// both work
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs
DB_POOL_MIN=1
DB_POOL_MAX=20

# Must be the same chart workspace review-ui mounts
DATA_ROOT=../review-ui/data/folders
METADATA_ROOT=../review-ui/data/metadata

API_HOST=0.0.0.0
API_PORT=8001
# Pages processed in parallel inside one chart's stage (e.g. OCR on 4 pages at once)
STAGE_WORKERS=4
# Charts processed in parallel inside one /batch (or cli batch) call
BATCH_WORKERS=4
# DB connections reserved beyond workers×STAGE_WORKERS (must fit DB_POOL_MAX)
BATCH_POOL_HEADROOM=2
# Cap concurrent Azure DI calls (billed); keep ≤ service quota
AZURE_DI_MAX_CONCURRENT=4
AZURE_RETRY_ATTEMPTS=5
AZURE_RETRY_BASE_DELAY=1.0
AZURE_RETRY_MAX_DELAY=30.0

# Blob intake: key | entra | entra_interactive
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline

# Final OCR 2 (billed per page) — leave blank to skip Azure text
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_POLL_TIMEOUT_SECONDS=180

# Docling final1 RapidOCR weights dir (relative to core-pipeline/) — download separately
RAPID_MODELS_DIR=models/rapidocr
# ConvNeXt HW weights (relative to core-pipeline/); RF .pkl if missing
HW_MODEL_PATH=models/hw/handwritten_printed_convnext_tiny.pth

# DOS LLM pass — blank endpoint ⇒ rules-only
DOS_LLM_ENABLED=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# key | entra | auto
AZURE_OPENAI_AUTH=auto
AZURE_OPENAI_API_KEY=

# Docker build + runtime NER; Rejection needs MEMBER_NER_ENABLED=true + models
WITH_NER=false
MEMBER_NER_ENABLED=false
MEMBER_NER_MODEL_ID=gliner_medium
MEMBER_NER_MODELS_PATH=

# Write corrected-pages/ when orientation changes
ROTATION_CORRECTION_ENABLED=true
# Reuse existing ocr/ files (skip prelim/final1/final2). If ocr/ missing → OCR still runs
SKIP_OCR=false
# Quiet Azure SDK HTTP dumps (WARNING recommended)
AZURE_LOG_LEVEL=WARNING
# Windows only if tesseract is not on PATH
TESSERACT_CMD=
