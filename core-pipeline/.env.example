# core-pipeline — copy to .env and fill in.
#
# Paths are relative to core-pipeline/. Lines that are commented out show the
# default; uncomment only to change it. Sections run from "must set" to
# "leave alone unless diagnosing". Models: docs/HOW_TO_RUN.md § Models.

# =============================================================================
# 1. REQUIRED
# =============================================================================

# Postgres, shared with review-ui. Apply schema/v1.sql once before starting.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs

# Chart workspace. review-ui mounts the same folders read-only.
DATA_ROOT=../review-ui/data/folders
METADATA_ROOT=../review-ui/data/metadata

# Tesseract binary. Leave blank when `tesseract` is on PATH (macOS/Linux).
# Windows always: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# =============================================================================
# 2. AZURE — each block is optional; a missing one degrades its stage visibly
# =============================================================================

# --- Blob storage (input_type "blob"). Local paths need none of this. ---
# Auth: key | entra | entra_interactive | managed_identity
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
AZURE_CLIENT_ID=
AZURE_PRINCIPAL_ID=

# --- Stage 5, Final OCR 2: Azure Document Intelligence. BILLED PER PAGE. ---
# Blank ⇒ no Final2 text; handwritten pages get no pass-2 verdict.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DI_FEATURES=languages,barcodes
AZURE_POLL_TIMEOUT_SECONDS=180

# --- Date of service LLM pass: Azure OpenAI ---
# Blank endpoint or DOS_LLM_ENABLED=false ⇒ regex only (extraction_method='rules').
# Auth: auto | key | entra. auto uses the key when set, else Entra ID
# (the VM's managed identity, via azure-identity).
DOS_LLM_ENABLED=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_AUTH=auto
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# =============================================================================
# 3. MODELS — weights live in core-pipeline/models/, never in the image
# =============================================================================
# Defaults match the folder layout; change a path only if you moved a folder.

# Stage 1 handwriting / page type. The page-tag model goes in under this name.
HW_MODEL_PATH=models/hw/handwritten_printed_convnext_tiny.pth
# Stage 4 Final1: four RapidOCR files, plus Docling layout/table weights
# (Docling downloads its own on the first Final1 page when online).
RAPID_MODELS_DIR=models/rapidocr
DOCLING_ARTIFACTS_DIR=models/docling
# Stage 6 section headers: local MiniLM, else this Hub id, else lexical match.
SECTION_HEADER_MINILM_PATH=models/semantic-model
# SECTION_HEADER_MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Blank/junk TF-IDF (optional bert_page/ DistilBERT inside). Missing ⇒ regex.
BLANK_JUNK_MODEL_DIR=models/blank-junk
# Page family TF-IDF + XGBoost. Missing ⇒ keywords choose the family.
PAGE_FAMILY_MODEL_DIR=models/page-family
# Key/value extraction: kv-extraction/ and layout_heron/ under this root.
# Its GLiNER is the member NER checkpoint (MEMBER_NER_MODELS_PATH / MEMBER_NER_MODEL_ID).
# EXTRACTION_MODELS_ROOT=models
# EXTRACTION_DATA_ROOT=data/extraction
# Set to 1 on a machine without internet: a missing model is reported, not fetched.
# HF_HUB_OFFLINE=1

# --- Member NER (GLiNER). Rejection is only possible with this on. ---
# Needs models/ner/<checkpoint>; fetch with
#   python -m stages.lib.member.extractors.ner_based.model_downloader
MEMBER_NER_ENABLED=false
MEMBER_NER_MODEL_ID=gliner_medium
MEMBER_NER_MODELS_PATH=models/ner

# =============================================================================
# 4. STAGE SETTINGS
# =============================================================================

# --- Stage 1: rotation, tilt, mirror ---
ROTATION_CORRECTION_ENABLED=true
# A measured tilt above this many degrees is stored but not applied.
MAX_TILT_TO_APPLY=5

# --- Stage 4: Final1 (Docling + RapidOCR) ---
# On timeout or sparse output a page falls back to RapidOCR-onnx.
DOCLING_PAGE_TIMEOUT_SECONDS=90
DOCLING_TABLE_CELL_MATCHING=false
# DOCLING_TABLE_MODE=fast            # fast | accurate (accurate is ~10x slower)
# DOCLING_DO_TABLES=true
# DOCLING_IMAGES_SCALE=1.0
# DOCLING_EXPORT_DOCUMENT=false      # true adds the full Docling document to the JSON
# Leave unset: CUDA when present, else CPU. A Mac's MPS crashes the layout model.
# DOCLING_DEVICE=cpu

# --- Stage 6: section headers ---
SECTION_HEADER_SEMANTIC_ENABLED=true
SECTION_HEADER_SEMANTIC_THRESHOLD=0.90

# --- Page sequencing: optional cross-encoder ---
# Needs stages/lib/sequencing/artifacts/cross_encoder_mini_lm.onnx.
SEQUENCING_CROSS_ENCODER=false

# --- OCR reuse ---
# true: reuse ocr/ from the output folder or workspace, else rebuild it from
# ocr_results; OCR runs only when neither exists. Same as skip_ocr per request.
SKIP_OCR=false

# =============================================================================
# 5. THROUGHPUT
# =============================================================================
# Keep BATCH_WORKERS × STAGE_WORKERS + BATCH_POOL_HEADROOM ≤ DB_POOL_MAX,
# or batch-run returns 400.
DB_POOL_MIN=1
DB_POOL_MAX=20
STAGE_WORKERS=4
BATCH_WORKERS=4
BATCH_POOL_HEADROOM=2
# Docling is not safe under fan-out; Final1 pages queue on one convert.
DOCLING_WORKERS=1
# Charts above this many pages run one at a time inside a batch.
# LARGE_CHART_MIN_PAGES=500
AZURE_DI_MAX_CONCURRENT=4
AZURE_DI_CONNECTION_POOL_SIZE=32
AZURE_BLOB_CONNECTION_POOL_SIZE=50
AZURE_RETRY_ATTEMPTS=5
AZURE_RETRY_BASE_DELAY=1.0
AZURE_RETRY_MAX_DELAY=30.0

# =============================================================================
# 6. API AND DOCKER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8001

# Host folders docker compose mounts (read by compose, not by Python).
# DATA_HOST_PATH=../review-ui/data/folders
# METADATA_HOST_PATH=../review-ui/data/metadata
# MODELS_HOST_PATH=./models
# LOGS_HOST_PATH=./logs

# =============================================================================
# 7. LOGGING AND DEBUG
# =============================================================================
# Daily files under LOG_DIR (default ./logs), also mirrored to stdout.
LOG_TO_FILE=true
# LOG_DIR=
LOG_BACKUP_DAYS=30
# Colour [batch-N] / [page-N] tags: auto | true | false. NO_COLOR=1 also disables.
LOG_COLOR=auto
# INFO/DEBUG brings back the Azure HTTP dumps (for a 403 or throttling).
AZURE_LOG_LEVEL=WARNING

# Per-chart evidence files under <chart>/debug/ (never exported).
DOS_DEBUG=false
PAGE_CLASSIFY_DEBUG=false
ENCOUNTER_DEBUG=false
KV_DEBUG=false

# Native crash diagnostics. faulthandler prints a traceback on abort;
# one OpenMP thread stops Torch and ONNX pools fighting each other.
# If Docling crashes with heap corruption, try BATCH_WORKERS=1 first.
PYTHONFAULTHANDLER=1
OMP_NUM_THREADS=1
