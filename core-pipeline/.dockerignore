# Build context is `core-pipeline/`. Without this, `COPY .` ships the host
# venv and weight files into the image (tens of GB).
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
*.log
.DS_Store
._*
.AppleDouble

# Weights are mounted at runtime (MODELS_HOST_PATH), never baked in.
models/
!models/README.md

# Chart working folders and metadata CSVs (scratch, mounted at /data/outputs by compose).
# Copied in, they made every rebuild a new multi-GB layer and filled the builder cache.
outputs/
!outputs/README.md

# Runtime daily logs (mounted in compose); never bake into the image.
logs/
!logs/README.md

# Editor / agent noise
.claude/
.cursor/
